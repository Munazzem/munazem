{
  "expo": {
    "name": "منظم - ولي الأمر",
    "slug": "monazem-parent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "monazem",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f4c81"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.monazem.parent",
      "infoPlist": {
        "NSCameraUsageDescription": "نحتاج للوصول إلى الكاميرا لمسح كارت الطالب (QR / Barcode)",
        "UIUserInterfaceStyle": "Light"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f4c81"
      },
      "package": "app.monazem.parent",
      "permissions": [
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "نحتاج للوصول إلى الكاميرا لمسح كارت الطالب (QR / Barcode)"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0f4c81"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
