{
  "expo": {
    "name": "منظم - ولي الأمر",
    "slug": "monazem-parent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "monazem",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f4c81"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.monazem.parent",
      "infoPlist": {
        "NSCameraUsageDescription": "نحتاج للوصول إلى الكاميرا لمسح كارت الطالب (QR / Barcode)",
        "UIUserInterfaceStyle": "Light"
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f4c81"
      },
      "package": "app.monazem.parent",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "نحتاج للوصول إلى الكاميرا لمسح كارت الطالب (QR / Barcode)"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0f4c81"
        }
      ],
      "expo-asset"
    ],
    "updates": {
      "url": "https://u.expo.dev/9aa64a08-2aad-4799-946c-4cb7a9bf4798"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "9aa64a08-2aad-4799-946c-4cb7a9bf4798"
      }
    },
    "owner": "aymans1"
  }
}
